# ─────────────────────────────────────────────
# IntelliProject – Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Application
APP_NAME=IntelliProject
APP_VERSION=2.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.onrender.com,*

# ── Neon Database (PostgreSQL) ────────────────────────────────────────────────
# Paste your Neon connection string here. Example:
# postgresql://neondb_owner:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-replace-with-random-hex-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── AI Provider (Groq) ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Frontend Environment Variable (Vite) ─────────────────────────────────────
# Used by frontend to reach the backend API:
# In local development: http://localhost:8000/api/v1
# In Render production: https://intelliproject-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
